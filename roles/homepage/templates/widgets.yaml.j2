- glances:
    url: http://glances:61208
    version: 4
    cpu: true
    mem: true
    expanded: true
    label: Homelab
{% for disk in homepage_disks %}
- resources:
    label: {{ disk.label | to_json }}
    disk: /host/disks/{{ loop.index0 }}
    diskUnits: bbytes
    expanded: true
{% endfor %}
