{
	admin off
	auto_https off
	persist_config off
}

:{{ francois_rieux_web_port }} {
	@redirect host {{ francois_rieux_redirect_hosts | join(' ') if francois_rieux_redirect_hosts else 'redirect.invalid' }}
	redir @redirect https://{{ francois_rieux_host }}{uri} permanent

	handle /healthz {
		respond "ok" 200
	}

	root * /srv/site/current
	encode zstd gzip

	header {
{% for header_name, header_value in francois_rieux_security_headers.items() %}
		{{ header_name }} "{{ header_value }}"
{% endfor %}
		-Server
	}

	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@admin path /admin /admin/*
	header @admin {
		Cache-Control "no-store"
		X-Robots-Tag "noindex, nofollow"
	}

	@pages not path /_astro/* /admin /admin/*
	header @pages Cache-Control "public, max-age=300"

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
