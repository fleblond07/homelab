[Unit]
Description=WordPress database archive backup to Backblaze
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/homelab-wordpress-backup database
TimeoutStartSec=6h
TimeoutStopSec=120
UMask=0077
Nice=10
