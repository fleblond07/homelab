<?php
define('DB_NAME', {{ item.database_name | to_json | replace('$', '\\$') }});
define('DB_USER', {{ item.database_user | to_json | replace('$', '\\$') }});
define('DB_PASSWORD', {{ item.database_password | to_json | replace('$', '\\$') }});
define('DB_HOST', {{ item.database_host | default(wordpress_database_host) | to_json | replace('$', '\\$') }});
define('DB_CHARSET', 'utf8mb4');
define('DB_COLLATE', '');

{% set salts = item.auth_keys %}
define('AUTH_KEY',         {{ salts.AUTH_KEY | to_json | replace('$', '\\$') }});
define('SECURE_AUTH_KEY',  {{ salts.SECURE_AUTH_KEY | to_json | replace('$', '\\$') }});
define('LOGGED_IN_KEY',    {{ salts.LOGGED_IN_KEY | to_json | replace('$', '\\$') }});
define('NONCE_KEY',        {{ salts.NONCE_KEY | to_json | replace('$', '\\$') }});
define('AUTH_SALT',        {{ salts.AUTH_SALT | to_json | replace('$', '\\$') }});
define('SECURE_AUTH_SALT', {{ salts.SECURE_AUTH_SALT | to_json | replace('$', '\\$') }});
define('LOGGED_IN_SALT',   {{ salts.LOGGED_IN_SALT | to_json | replace('$', '\\$') }});
define('NONCE_SALT',       {{ salts.NONCE_SALT | to_json | replace('$', '\\$') }});

$table_prefix = {{ item.table_prefix | to_json }};

define('WP_DEBUG', {{ 'true' if item.debug | default(false) else 'false' }});
define('DISALLOW_FILE_EDIT', true);

// HTTPS terminates at the reverse proxy; WordPress receives HTTP internally.
if (isset($_SERVER['HTTP_X_FORWARDED_PROTO']) &&
    in_array('https', array_map('trim', explode(',', $_SERVER['HTTP_X_FORWARDED_PROTO'])), true)) {
    $_SERVER['HTTPS'] = 'on';
}

{% if item.smtp is defined %}
define('HOMELAB_SMTP_HOST', {{ item.smtp.host | to_json(ensure_ascii=False) | replace('$', '\\$') }});
define('HOMELAB_SMTP_PORT', {{ item.smtp.port | default(wordpress_smtp_port) | int }});
define('HOMELAB_SMTP_ENCRYPTION', {{ item.smtp.encryption | default(wordpress_smtp_encryption) | to_json(ensure_ascii=False) | replace('$', '\\$') }});
define('HOMELAB_SMTP_USERNAME', {{ item.smtp.username | to_json(ensure_ascii=False) | replace('$', '\\$') }});
define('HOMELAB_SMTP_PASSWORD', {{ item.smtp.password | to_json(ensure_ascii=False) | replace('$', '\\$') }});
define('HOMELAB_SMTP_FROM_EMAIL', {{ item.smtp.from_email | to_json(ensure_ascii=False) | replace('$', '\\$') }});
{% if item.smtp.from_name is defined %}
define('HOMELAB_SMTP_FROM_NAME', {{ item.smtp.from_name | to_json(ensure_ascii=False) | replace('$', '\\$') }});
{% endif %}

{% endif %}
{% for constant_name, constant_value in item.extra_constants | default({}) | dictsort %}
define('{{ constant_name }}', {{ constant_value | to_json | replace('$', '\\$') }});
{% endfor %}

if (!defined('ABSPATH')) {
    define('ABSPATH', __DIR__ . '/');
}

require_once ABSPATH . 'wp-settings.php';
