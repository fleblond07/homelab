services:
  cloudflared:
    image: {{ cloudflare_tunnel_image | to_json }}
    container_name: {{ cloudflare_tunnel_container_name | to_json }}
    restart: unless-stopped
    dns: {{ homelab_networks_dns_servers | default(['1.1.1.1', '1.0.0.1']) | to_json }}
    user: {{ (cloudflare_tunnel_uid ~ ':' ~ cloudflare_tunnel_gid) | to_json }}
    command:
      - tunnel
      - --no-autoupdate
      - --metrics
      - 0.0.0.0:2000
      - run
      - --token-file
      - /run/secrets/tunnel-token
    volumes:
      - {{ (cloudflare_tunnel_secret_dir ~ '/token:/run/secrets/tunnel-token:ro') | to_json }}
    ports:
      - {{ ('127.0.0.1:' ~ cloudflare_tunnel_metrics_port ~ ':2000') | to_json }}
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    networks:
      - tunnel-origin
      - homelab-flb-dev
{% for site in wordpress_sites | default([]) %}
      - {{ ('homelab-wordpress-' ~ site.name) | to_json }}
{% endfor %}

networks:
  tunnel-origin:
    external: true
    name: {{ cloudflare_tunnel_network | to_json }}
  homelab-flb-dev:
    external: true
{% for site in wordpress_sites | default([]) %}
  {{ ('homelab-wordpress-' ~ site.name) | to_json }}:
    external: true
{% endfor %}
